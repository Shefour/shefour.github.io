{% extends 'base.html.twig' %}

{% block title %}Tea{% endblock %}

{% block body %}
    <h1>Tea</h1>

    <table class="table table-striped">
        <tbody>
        <tr>
            <th>Id</th>
            <td>{{ tea.id }}</td>
        </tr>
        <tr>
            <th>Name</th>
            <td>{{ tea.name }}</td>
        </tr>
        <tr>
            <th>Type</th>
            <td>{{ tea.type }}</td>
        </tr>
        <tr>
            <th>Description</th>
            <td>{{ tea.description }}</td>
        </tr>
        </tbody>
    </table>

    <div class="d-flex gap-2">
        <a href="{{ path('app_tea_index') }}" class="btn btn-secondary mt-2">Back to list</a>
        <a href="{{ path('app_tea_edit', {'id': tea.id}) }}" class="btn btn-primary mt-2">Edit</a>
        {{ include('tea/_delete_form.html.twig') }}
    </div>
{% endblock %}
